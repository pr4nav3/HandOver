{
  "id": "front-wheel-v1",
  "title": "Inspect and reinstall a front wheel",
  "description": "Remove the front wheel, inspect the rim and brake pads, then reinstall it and confirm the brake works.",
  "video": "norm.mp4",
  "safety": [],
  "tools": [
    "bicycle",
    "front wheel",
    "quick release skewer"
  ],
  "steps": [
    {
      "n": 1,
      "title": "Turn the bike over, open the quick release and drop the wheel out",
      "start": "00:07.1",
      "end": "00:19",
      "check_type": "camera",
      "check_question": "Are both fork ends empty, with no wheel between the fork blades?",
      "prerequisites": [],
      "ref_time": "00:18.5",
      "common_mistake": "Flip the lever open first, then lift the frame so the wheel drops out.",
      "clip": "clips_produced/01.mp4",
      "captions": "clips_produced/01.vtt",
      "ref_frame": "frames/01.jpg"
    },
    {
      "n": 2,
      "title": "Take the skewer out: nut off, slide it out, springs narrow end in",
      "start": "00:19",
      "end": "01:13",
      "check_type": "camera",
      "check_question": "Is the skewer out of the wheel, held apart from the hub?",
      "prerequisites": [
        1
      ],
      "ref_time": "01:12.5",
      "common_mistake": "Keep both springs; each one points its narrow end toward the hub.",
      "clip": "clips_produced/02.mp4",
      "captions": "clips_produced/02.vtt",
      "ref_frame": "frames/02.jpg"
    },
    {
      "n": 3,
      "title": "Spin the wheel and run your fingers round the braking track",
      "start": "01:13",
      "end": "01:31",
      "check_type": "manual",
      "check_question": "",
      "prerequisites": [
        2
      ],
      "ref_time": "01:27.4",
      "common_mistake": "Feel the flat metal band the pads touch, all the way round.",
      "clip": "clips_produced/03.mp4",
      "captions": "clips_produced/03.vtt",
      "ref_frame": "frames/03.jpg"
    },
    {
      "n": 4,
      "title": "Check the brake calipers and pads from above",
      "start": "01:31",
      "end": "01:40",
      "check_type": "manual",
      "check_question": "",
      "prerequisites": [
        3
      ],
      "ref_time": "01:38.6",
      "common_mistake": "Each pad should face the braking track, not the tire.",
      "clip": "clips_produced/04.mp4",
      "captions": "clips_produced/04.vtt",
      "ref_frame": "frames/04.jpg"
    },
    {
      "n": 5,
      "title": "Set the wheel back in the fork with the tread arrow pointing forward, then check the rear tire the same way",
      "start": "01:40",
      "end": "02:05",
      "check_type": "camera",
      "check_question": "Is the wheel sitting between the fork blades with the axle in the fork ends?",
      "prerequisites": [
        4
      ],
      "ref_time": "01:44.5",
      "common_mistake": "The arrow on the sidewall points the way the bike rolls.",
      "clip": "clips_produced/05.mp4",
      "captions": "clips_produced/05.vtt",
      "ref_frame": "frames/05.jpg"
    },
    {
      "n": 6,
      "title": "Slide the skewer back through the hub and thread the nut on",
      "start": "02:05",
      "end": "02:36",
      "check_type": "camera",
      "check_question": "Is the skewer through the hub with the lever on one side and the nut on the other?",
      "prerequisites": [
        5
      ],
      "ref_time": "02:35.5",
      "common_mistake": "The lever goes on the left side of the bike, away from the chain.",
      "clip": "clips_produced/06.mp4",
      "captions": "clips_produced/06.vtt",
      "ref_frame": "frames/06.jpg"
    },
    {
      "n": 7,
      "title": "Snug the nut and close the lever flat along the fork",
      "start": "02:36",
      "end": "03:03.1",
      "check_type": "camera",
      "check_question": "Is the quick release lever folded closed, lying flat along the fork blade?",
      "prerequisites": [
        6
      ],
      "ref_time": "03:03",
      "common_mistake": "Fold the lever back along the fork. A lever pointing forward can catch and open.",
      "clip": "clips_produced/07.mp4",
      "captions": "clips_produced/07.vtt",
      "ref_frame": "frames/07.jpg"
    },
    {
      "n": 8,
      "title": "Spin the wheel and squeeze the brake",
      "start": "03:03.1",
      "end": "03:18.6",
      "check_type": "camera",
      "check_question": "Is the bike upright on its wheels with the front wheel in the fork?",
      "prerequisites": [
        7
      ],
      "ref_time": "03:18",
      "common_mistake": "Spin the wheel once and squeeze the brake before you ride.",
      "clip": "clips_produced/08.mp4",
      "captions": "clips_produced/08.vtt",
      "ref_frame": "frames/08.jpg"
    }
  ],
