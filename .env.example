# Copy to .env at the repo root. Never commit .env.
# Claude key: the live check provider (HANDOVER_CHECK_PROVIDER=auto) picks Claude Haiku when this is set.
ANTHROPIC_API_KEY=
# Gemini key: used for teach-time extraction, and for live checks when no ANTHROPIC_API_KEY is set.
GEMINI_API_KEY=
# Databricks (only after the live loop works; see docs/PLAN.md)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
