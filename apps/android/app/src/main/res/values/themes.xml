<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose, shown for a moment at launch. Compose draws everything else. -->
    <style name="Theme.HandOver" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
